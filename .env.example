NODE_ENV=development
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_ISSUER=ticketing
JWT_AUDIENCE=ticketing-api
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
SMTP_HOST=localhost
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace_with_your_resend_api_key
RESEND_FROM=no-reply@example.com
# Alternative : EMAIL_PROVIDER=smtp et paramètres SMTP ci-dessous
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@ticketing.local
# SMTP_USER=
# SMTP_PASSWORD=
# Générer une clé dédiée : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTBOX_ENCRYPTION_KEY=replace_with_64_random_hex_characters
PORT=3000
DATABASE_URL="postgresql://ticketing:change_me@localhost:5432/ticketing?schema=public"
# Base dédiée aux tests d'intégration ; jamais la base de production.
TEST_DATABASE_URL="postgresql://ticketing:change_me@localhost:5432/ticketing_test?schema=public"
