generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
  USER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(200)
  email           String   @unique @db.VarChar(254)
  role            UserRole @default(USER)
  status          UserStatus @default(INVITED)
  passwordHash    String?
  createdAt       DateTime @default(now())
  createdTickets  Ticket[] @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")
  resolvedTickets Ticket[] @relation("TicketResolver")
  sessions        AuthSession[]
  actionTokens    ActionToken[]
}

model AuthSession {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  refreshTokens RefreshToken[]
  @@index([userId])
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  hash String @unique
  sessionId String @db.Uuid
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumedAt DateTime?
  @@index([sessionId])
  @@index([expiresAt])
}

model EmailOutbox {
  id String @id @default(uuid()) @db.Uuid
  payload String?
  actionTokenId String? @db.Uuid
  actionToken ActionToken? @relation(fields: [actionTokenId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  availableAt DateTime @default(now())
  attempts Int @default(0)
  lockedUntil DateTime?
  lockToken String? @db.Uuid
  deliveredAt DateTime?
  abandonedAt DateTime?
  @@index([availableAt, lockedUntil])
}

enum ActionTokenType {
  INVITATION
  PASSWORD_RESET
}

model ActionToken {
  id String @id @default(uuid()) @db.Uuid
  hash String @unique
  type ActionTokenType
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumedAt DateTime?
  emails EmailOutbox[]
  @@index([userId, type])
  @@index([expiresAt])
}

model Ticket {
  id           String         @id @default(uuid()) @db.Uuid
  title        String         @db.VarChar(200)
  description  String?
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?        @db.Uuid
  assignedToId String?        @db.Uuid
  resolveById  String?        @db.Uuid
  createdBy    User?          @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  resolveBy    User?          @relation("TicketResolver", fields: [resolveById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([assignedToId])
  @@index([resolveById])
}
